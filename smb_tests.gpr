with "smb.gpr";

project SMB_Tests is
   for Source_Dirs use ("tests");
   for Object_Dir use "build/test-obj";
   for Exec_Dir use "build/bin";
   for Main use
     ("test_suite.adb", "integration_client.adb", "adversarial_client.adb",
      "transport_client.adb", "cleanup_client.adb", "unicode_probe.adb",
      "auth_diagnostic_client.adb", "response_mutation_client.adb",
      "security_buffer_client.adb", "async_client.adb", "ntlm_av_probe.adb",
      "crypto_probe.adb", "clock_probe.adb", "entropy_failure_client.adb");
   for Languages use ("Ada");

   --  Every scalar the code leaves unset starts invalid, and every use is
   --  checked: an output that a subprogram forgets to set then fails the
   --  tests on every platform, rather than passing whenever a stale value
   --  happens to be the expected one.
   package Builder is
      for Global_Configuration_Pragmas use "tests/initialize_scalars.adc";
      for Global_Compilation_Switches ("Ada") use ("-gnatVa");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end SMB_Tests;
