library project SMB is
   type Platform_Kind is ("Unix", "Windows_NT");
   Platform : Platform_Kind := external ("ADASMB_OS", external ("OS", "Unix"));
   case Platform is
      when "Windows_NT" =>
         for Source_Dirs use ("src", "src/platform/windows");
      when "Unix" =>
         for Source_Dirs use ("src", "src/platform/unix");
   end case;
   for Object_Dir use "build/obj";
   for Library_Dir use "build/lib";
   for Library_Name use "smb";
   for Library_Kind use "static";
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end SMB;
