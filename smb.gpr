library project SMB is
   type Platform_Kind is ("Unix", "Windows_NT");
   Platform : Platform_Kind := external ("ADASMB_OS", external ("OS", "Unix"));
   case Platform is
      when "Windows_NT" =>
         for Source_Dirs use ("src", "src/platform/windows");
      when "Unix" =>
         for Source_Dirs use ("src", "src/platform/unix");
   end case;
   for Object_Dir use "build/obj";
   for Library_Dir use "build/lib";
   for Library_Name use "smb";
   for Library_Kind use "static";
   for Languages use ("Ada");

   --  "proved", the default, checks at run time only the preconditions of the
   --  SPARK core, whose other contracts GNATprove proves (contracts.adc);
   --  "all" checks every contract, as the test build does.
   type Contract_Checks_Kind is ("proved", "all");
   Contract_Checks : Contract_Checks_Kind :=
     external ("ADASMB_CONTRACT_CHECKS", "proved");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa", "-gnatwJ");
      case Contract_Checks is
         when "proved" =>
            for Local_Configuration_Pragmas use "contracts.adc";
         when "all" =>
            null;
      end case;
   end Compiler;
end SMB;
