with "smb.gpr";

project SMB_Example is
   for Source_Dirs use ("example");
   for Object_Dir use "build/example-obj";
   for Exec_Dir use "build/bin";
   for Main use ("smb_example.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end SMB_Example;
