project Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "build/proof-obj";
   for Source_Files use
     ("smb.ads",
      "smb-crypto.ads",
      "smb-crypto.adb",
      "smb-aes.ads",
      "smb-aes.adb",
      "smb-aes-cmac.ads",
      "smb-aes-cmac.adb",
      "smb-kdf.ads",
      "smb-kdf.adb",
      "smb-core_wire.ads",
      "smb-core_wire.adb",
      "smb-core_text.ads",
      "smb-core_text.adb",
      "smb-core_ntlm.ads",
      "smb-core_ntlm.adb",
      "smb-core_auth.ads",
      "smb-core_auth.adb",
      "smb-core_framing.ads",
      "smb-core_framing.adb",
      "smb-core_transport.ads",
      "smb-core_transport.adb",
      "smb-core_clock.ads",
      "smb-core_clock.adb",
      "smb-core_protocol.ads",
      "smb-core_protocol.adb",
      "smb-core_connection.ads",
      "smb-core_connection.adb",
      "smb-core_client.ads",
      "smb-core_client.adb",
      "smb-engine.ads",
      "smb-engine.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;

   --  A --timeout on the command line overrides these, so make prove passes
   --  none. The three units below hold the only checks that take 40 seconds
   --  or more on an M4 Mac (up to 83); the GitHub runner is about half as
   --  fast, and two of them passed 120 seconds there.
   package Prove is
      for Proof_Switches ("Ada") use ("--timeout=120");
      for Proof_Switches ("smb-core_text.adb") use ("--timeout=300");
      for Proof_Switches ("smb-core_protocol.adb") use ("--timeout=300");
      for Proof_Switches ("smb-core_client.adb") use ("--timeout=300");
   end Prove;
end Proof;
